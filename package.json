{
  "name": "software-factory-durable",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && npm run prepare:sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long . && eslint . --max-warnings 0",
    "test": "npm run test:ci",
    "test:fast": "scripts/test-runner/run fast",
    "test:ci": "scripts/test-runner/run ci",
    "test:full": "scripts/test-runner/run full",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "prepare:sdk": "node dist/src/workers/sdk-profile.js && node dist/src/sandbox/gondolin-sdk-profile.js",
    "prepare:gondolin-sdk": "node dist/src/sandbox/gondolin-sdk-profile.js"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/gondolin": "0.14.0",
    "@earendil-works/pi-durable": "1.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3"
  },
  "imports": {
    "#factory-pi": {
      "types": "@earendil-works/pi-coding-agent",
      "default": "./.scratch/factory-development-sdk-v3/sdk/dist/index.js"
    },
    "#factory-pi-auth-storage": {
      "types": "./.scratch/factory-development-sdk-v3/sdk/dist/core/auth-storage.d.ts",
      "default": "./.scratch/factory-development-sdk-v3/sdk/dist/core/auth-storage.js"
    },
    "#factory-pi-model-runtime": {
      "types": "./.scratch/factory-development-sdk-v3/sdk/dist/core/model-runtime.d.ts",
      "default": "./.scratch/factory-development-sdk-v3/sdk/dist/core/model-runtime.js"
    },
    "#factory-image-mime": {
      "types": "./src/workers/image-mime.d.ts",
      "default": "./.scratch/factory-development-sdk-v3/image-mime.js"
    }
  }
}
