  "skills": [
    {
      "name": "implement",
      "path": "skills/implement/SKILL.md",
      "description": "Implement the Factory Ticket of this Execution: preserve its request and instructions first, implement test-first in the Work's own checkout, hand off for the Factory reviews with gates and treatments (repeated rounds when enabled), continue or recover after an answer or an authorized scope change, and publish directly only when the Factory requests it. Started explicitly by /implement.",
      "modelInvocation": false,
      "role": "builder"
    },
    {
      "name": "tdd",
      "path": "skills/tdd/SKILL.md",
      "description": "Test-driven development at seams agreed by prior concrete authorization.",
      "modelInvocation": true,
      "role": "builder"
    },
    {
      "name": "codebase-design",
      "path": "skills/codebase-design/SKILL.md",
      "description": "Shared vocabulary for designing deep modules (reference for tdd).",
      "modelInvocation": true,
      "role": "builder"
    },
    {
      "name": "code-review",
      "path": "skills/code-review/SKILL.md",
      "description": "Two-axis self-check (Standards, Spec) of the Builder changes since the base commit; authoritative reviews are run by the Factory.",
      "modelInvocation": true,
      "role": "builder"
    },
    {
      "name": "pr",
      "path": "skills/pr/SKILL.md",
      "description": "Pull request body (Summary/Validation/Risk with the Factory marker) and the direct publication procedure of a Factory-requested publish-only activation.",
      "modelInvocation": true,
      "role": "builder"
    },
    {
      "name": "alpine-diagnostics",
      "path": "skills/alpine-diagnostics/SKILL.md",
      "description": "Preparing and diagnosing the Factory guest (Alpine/musl, Docker vfs, mediated HTTPS).",
      "modelInvocation": true,
      "role": "builder"
    },
    {
      "name": "triage",
      "path": "skills/triage/SKILL.md",
      "description": "Triage the Factory Ticket of this activation alone: investigate by reading, apply the criteria of each outcome and record one Verdict with `concluir_triagem`. Started only by the Factory activation prompt.",
      "modelInvocation": false,
      "role": "triager"
    }
  ],
  "prompts": [
    {
      "name": "implement",
      "path": "prompts/implement.md",
      "description": "Factory Builder start: preserve the Ticket request, then implement it in the Work's own checkout.",
      "role": "builder"
    },
    {
      "name": "pr",
      "path": "prompts/pr.md",
      "description": "Factory pull request body and, only when the Factory requests it, direct publication of the own draft pull request.",
      "role": "builder"
    },
    {
      "name": "triage",
      "path": "prompts/triage.md",
      "description": "Factory Triager activation: the `triage` skill, its support document and what the Factory controller knows about the Ticket.",
      "role": "triager"
    }
  ],
