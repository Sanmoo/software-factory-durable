diff --git a/sdk/dist/src/sandbox/stdin-capacity.js b/sdk/dist/src/sandbox/stdin-capacity.js
new file mode 100644
index 0000000..c4b1b5c
--- /dev/null
+++ b/sdk/dist/src/sandbox/stdin-capacity.js
@@ -0,0 +1,18 @@
+// Pure stdin constraints: shared with option resolution, without boot dependencies.
+export const DEFAULT_MAX_STDIN_BYTES = 64 * 1024;
+export const DEFAULT_MAX_QUEUED_STDIN_BYTES = 8 * 1024 * 1024;
+export const DEFAULT_MAX_TOTAL_QUEUED_STDIN_BYTES = 32 * 1024 * 1024;
+
+export function validateStdinCapacity(option, limits) {
+    if (option === null || typeof option !== "object" || Array.isArray(option)) {
+        throw new Error("stdinCapacity must be an object with maxChunkBytes");
+    }
+    const maxChunkBytes = option.maxChunkBytes;
+    if (!Number.isSafeInteger(maxChunkBytes) || maxChunkBytes <= 0 ||
+        maxChunkBytes > (limits.maxStdinBytes ?? DEFAULT_MAX_STDIN_BYTES) ||
+        maxChunkBytes > (limits.maxQueuedStdinBytes ?? DEFAULT_MAX_QUEUED_STDIN_BYTES) ||
+        maxChunkBytes > (limits.maxTotalQueuedStdinBytes ?? DEFAULT_MAX_TOTAL_QUEUED_STDIN_BYTES)) {
+        throw new Error("stdin capacity chunk declaration exceeds native limits");
+    }
+    return maxChunkBytes;
+}
