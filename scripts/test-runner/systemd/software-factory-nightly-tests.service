# Versioned only. Installation is an explicit operator step (docs/development.md, "Camadas de teste").
[Unit]
Description=Software Factory nightly full test tier (local branch, no network)

[Service]
Type=oneshot
# Adjust both paths before installing: the main checkout and the pinned Node 24.21.0 bin directory.
Environment=SF_NIGHTLY_REPO=%h/dev/github.com/Sanmoo/software-factory-durable
Environment=SF_NIGHTLY_BRANCH=main
Environment=PATH=%h/.local/share/mise/installs/node/24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec "$SF_NIGHTLY_REPO/scripts/test-runner/nightly"'
Nice=10
RuntimeMaxSec=2h
