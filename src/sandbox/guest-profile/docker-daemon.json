{
  "storage-driver": "vfs",
  "features": {
    "containerd-snapshotter": false
  },
  "exec-opts": [
    "native.cgroupdriver=cgroupfs"
  ],
  "hosts": [
    "unix:///run/docker.sock"
  ],
  "group": "root",
  "bridge": "none",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-masq": false,
  "userland-proxy": false
}
